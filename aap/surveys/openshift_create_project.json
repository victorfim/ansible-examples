{
  "name": "Criar projeto no OpenShift",
  "description": "Parâmetros do playbook playbooks/openshift/create_project.yml",
  "spec": [
    {
      "question_name": "Nome do projeto",
      "question_description": "Até 63 caracteres: letras minúsculas, números e hífen.",
      "variable": "project_name",
      "type": "text",
      "required": true,
      "min": 1,
      "max": 63,
      "default": ""
    },
    {
      "question_name": "Nome de exibição",
      "question_description": "Nome mostrado no console do OpenShift (opcional).",
      "variable": "project_display_name",
      "type": "text",
      "required": false,
      "min": 0,
      "max": 256,
      "default": ""
    },
    {
      "question_name": "Descrição",
      "question_description": "Descrição do projeto (opcional).",
      "variable": "project_description",
      "type": "textarea",
      "required": false,
      "min": 0,
      "max": 1024,
      "default": ""
    },
    {
      "question_name": "Implantar aplicação httpd de exemplo?",
      "question_description": "Cria build, Deployment, Service e Route de uma aplicação httpd de exemplo no projeto.",
      "variable": "deploy_sample_app",
      "type": "multiplechoice",
      "required": true,
      "choices": "true\nfalse",
      "default": "true"
    },
    {
      "question_name": "Nome da aplicação",
      "question_description": "Nome da aplicação de exemplo. Somado ao nome do projeto, no máximo 62 caracteres.",
      "variable": "app_name",
      "type": "text",
      "required": false,
      "min": 1,
      "max": 61,
      "default": "httpd-example"
    }
  ]
}
