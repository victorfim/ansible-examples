{
  "name": "CreateProject",
  "description": "Parâmetros do playbook playbooks/openshift/create_project.yml",
  "spec": [
    {
      "question_name": "Nome do projeto",
      "question_description": "Até 63 caracteres: letras minúsculas, números e hífen.",
      "variable": "project_name",
      "type": "text",
      "required": true,
      "min": 1,
      "max": 63,
      "default": ""
    },
    {
      "question_name": "Nome de exibição",
      "question_description": "Nome mostrado no console do OpenShift (opcional).",
      "variable": "project_display_name",
      "type": "text",
      "required": false,
      "min": 0,
      "max": 256,
      "default": ""
    },
    {
      "question_name": "Descrição",
      "question_description": "Descrição do projeto (opcional).",
      "variable": "project_description",
      "type": "textarea",
      "required": false,
      "min": 0,
      "max": 1024,
      "default": ""
    },
    {
      "question_name": "Dono no catálogo",
      "question_description": "Usuário ou grupo do Developer Hub dono das entidades (ex.: group:default/time-a).",
      "variable": "catalog_owner",
      "type": "text",
      "required": true,
      "min": 1,
      "max": 255,
      "default": "group:default/plataforma"
    },
    {
      "question_name": "Visibilidade do repositório",
      "question_description": "Visibilidade do repositório GitHub criado para o projeto.",
      "variable": "github_repo_visibility",
      "type": "multiplechoice",
      "required": true,
      "choices": [
        "private",
        "public"
      ],
      "default": "private"
    }
  ]
}
